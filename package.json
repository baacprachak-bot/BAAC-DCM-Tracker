{
  "name": "baac-dcm-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env tools/dev.js",
    "start": "node --env-file-if-exists=.env tools/dev.js",
    "build": "node tools/build.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "deploy": "node --use-env-proxy --env-file-if-exists=.env tools/deploy.js",
    "line:menu": "node --use-env-proxy --env-file-if-exists=.env tools/line-menu.js"
  }
}
